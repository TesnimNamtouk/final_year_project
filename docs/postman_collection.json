{
  "info": {
    "name": "RecoApp API",
    "_postman_id": "recoapp-api-collection-v1",
    "description": "AI-powered content recommendation API — RecoApp",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\",\n  \"username\": \"testuser\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            },
            "description": "Register a new user. Returns accessToken and user info."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  pm.collectionVariables.set('accessToken', json.data.accessToken);",
                  "  pm.test('Register successful', () => pm.expect(pm.response.code).to.equal(201));",
                  "  pm.test('Has accessToken', () => pm.expect(json.data.accessToken).to.be.a('string'));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Login with credentials. Saves accessToken to collection variable."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  pm.collectionVariables.set('accessToken', json.data.accessToken);",
                  "  pm.test('Login successful', () => pm.expect(pm.response.code).to.equal(200));",
                  "  pm.test('Has accessToken', () => pm.expect(json.data.accessToken).to.be.a('string'));",
                  "  pm.test('Has user', () => pm.expect(json.data.user).to.be.an('object'));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Me",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me"]
            },
            "description": "Get authenticated user's profile. Requires Bearer token."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.expect(pm.response.code).to.equal(200));",
                  "pm.test('Has user data', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.data).to.have.property('email');",
                  "  pm.expect(json.data).to.have.property('username');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Content",
      "item": [
        {
          "name": "Search Content",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/content/search?q=inception&type=movie",
              "host": ["{{baseUrl}}"],
              "path": ["api", "content", "search"],
              "query": [
                {
                  "key": "q",
                  "value": "inception"
                },
                {
                  "key": "type",
                  "value": "movie"
                }
              ]
            },
            "description": "Search content by query string and optional type filter."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.expect(pm.response.code).to.equal(200));",
                  "pm.test('Returns array', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.data).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "User Content",
      "item": [
        {
          "name": "Save Content",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"contentId\": \"tt1375666\",\n  \"title\": \"Inception\",\n  \"type\": \"movie\",\n  \"year\": 2010,\n  \"genres\": [\"Action\", \"Sci-Fi\", \"Thriller\"],\n  \"status\": \"want_to_watch\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/user-content",
              "host": ["{{baseUrl}}"],
              "path": ["api", "user-content"]
            },
            "description": "Save a content item to the authenticated user's list."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201 or 200', () => pm.expect([200, 201]).to.include(pm.response.code));",
                  "pm.test('Has data', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.data).to.exist;",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Recommendations",
      "item": [
        {
          "name": "Get Recommendations",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/recommendations",
              "host": ["{{baseUrl}}"],
              "path": ["api", "recommendations"]
            },
            "description": "Get personalized recommendations for the authenticated user. Falls back to DB if ML service is unavailable."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.expect(pm.response.code).to.equal(200));",
                  "pm.test('Returns recommendations array', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.data).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Onboarding",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"genres\": [\"Action\", \"Sci-Fi\"],\n  \"contentIds\": [\"tt1375666\", \"tt0468569\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/1/onboarding",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "1", "onboarding"]
            },
            "description": "Submit user onboarding preferences (genres and initial content likes)."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.expect(pm.response.code).to.equal(200));",
                  "pm.test('Has data', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.data).to.exist;",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}

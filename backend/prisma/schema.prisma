generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  passwordHash String    @map("password_hash")
  username     String    @unique
  language     String    @default("tr")
  phone        String?
  avatarUrl    String?   @map("avatar_url")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  userContents    UserContent[]
  preferences     UserPreference?
  recommendations Recommendation[]
  refreshTokens   RefreshToken[]

  @@map("users")
}

model Content {
  id          Int         @id @default(autoincrement())
  externalId  String      @map("external_id")
  type        ContentType
  title       String
  titleEn     String?     @map("title_en")
  description String?     @db.Text
  genres      String[]
  year        Int?
  posterUrl   String?     @map("poster_url")
  rating      Float?
  metadata    Json?
  createdAt   DateTime    @default(now()) @map("created_at")

  userContents    UserContent[]
  recommendations Recommendation[]

  @@unique([externalId, type])
  @@map("content")
}

enum ContentType {
  movie
  series
  book
}

model UserContent {
  id        Int           @id @default(autoincrement())
  userId    Int           @map("user_id")
  contentId Int           @map("content_id")
  rating    Int? // 1-10
  status    ContentStatus @default(watched)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId])
  @@map("user_content")
}

enum ContentStatus {
  watched
  want
  reading
  read
}

model UserPreference {
  id              Int      @id @default(autoincrement())
  userId          Int      @unique @map("user_id")
  preferredGenres String[] @map("preferred_genres")
  onboardingDone  Boolean  @default(false) @map("onboarding_done")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model Recommendation {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  contentId   Int      @map("content_id")
  hybridScore Float    @map("hybrid_score")
  cbfScore    Float    @map("cbf_score")
  cfScore     Float    @map("cf_score")
  liked       Boolean?
  generatedAt DateTime @default(now()) @map("generated_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId])
  @@map("recommendations")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}
